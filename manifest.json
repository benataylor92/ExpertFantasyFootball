{
  "manifest_version": 3,
  "name": "Site-specific side panel",
  "version": "1.0",
  "description": "Shows how to display the side panel only on google.com using the Side Panel API.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Click to open panel",
    "default_popup": "sidepanel.html"
  },
  "permissions": [
    "activeTab", "scripting", "sidePanel", "tabs", "storage", "notifications"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "<all_urls>"
  ],
    "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+B",
        "mac": "Command+B"
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "<all_urls>"
      ],
      "js": [
        "ExpectedPoints.js",
        "tabs.js",
        "BestCaptains.js",
        "OverAndUnderAchievers.js",
        "CreateTable.js",
        "PriceEstimate.js",
        "Differentials.js",
        "SuspensionTightrope.js",
        "workOutTeamFromTeamId.js",
        "InjuriesAndNews.js",
        "TopPlayersInTheWorld.js",
        "MyTeam.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "*.js",
        "*.css",
        "*.svg",
        "icon-128.png",
        "test_fixtures.json"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ]
}